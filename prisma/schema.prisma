generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Team {
  id        String   @id @default(cuid())
  name      String
  ageGroup  String
  club      String
  createdAt DateTime @default(now())
  players   Player[]
  events    Event[]
  messages  Message[]
}

model Player {
  id           String         @id @default(cuid())
  teamId       String
  firstName    String
  lastName     String
  position     String
  parentName   String?
  parentEmail  String?
  team         Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  availability Availability[]
  feedback     Feedback[]
  selections   MatchSelection[]
  createdAt    DateTime       @default(now())
  @@index([teamId])
}

enum EventType {
  TRAINING
  MATCH
}

enum AvailabilityStatus {
  AVAILABLE
  UNAVAILABLE
  MAYBE
  PENDING
}

enum SquadRole {
  STARTING
  SUBSTITUTE
  NOT_SELECTED
}

model Event {
  id              String         @id @default(cuid())
  teamId          String
  type            EventType
  title           String
  opponent        String?
  startsAt        DateTime
  endsAt          DateTime?
  venue           String
  arrivalTime     DateTime?
  matchFormation  String?
  matchKit        String?
  matchResult     String?
  matchScoreFor   Int?
  matchScoreAgainst Int?
  matchNotes      String?
  team            Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  availability   Availability[]
  feedback       Feedback[]
  selections     MatchSelection[]
  eventMessages  EventMessage[]
  createdAt      DateTime       @default(now())
  @@index([teamId, startsAt])
}

model Availability {
  id          String             @id @default(cuid())
  eventId     String
  playerId    String
  status      AvailabilityStatus @default(PENDING)
  reason      String?
  respondedAt DateTime?
  event       Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  player      Player             @relation(fields: [playerId], references: [id], onDelete: Cascade)
  @@unique([eventId, playerId])
  @@index([eventId, status])
}

model MatchSelection {
  id         String    @id @default(cuid())
  eventId    String
  playerId   String
  role       SquadRole @default(NOT_SELECTED)
  position   String?
  isCaptain  Boolean   @default(false)
  event      Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  player     Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
  @@unique([eventId, playerId])
  @@index([eventId, role])
}

model Feedback {
  id          String   @id @default(cuid())
  playerId    String
  eventId     String?
  coachName   String
  wentWell    String?
  needsWork   String?
  focusNext   String?
  passing     Int?
  firstTouch  Int?
  positioning Int?
  confidence  Int?
  createdAt   DateTime @default(now())
  player      Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  event       Event?   @relation(fields: [eventId], references: [id], onDelete: SetNull)
  @@index([playerId, createdAt])
}

model Message {
  id        String   @id @default(cuid())
  teamId    String
  sender    String
  body      String
  createdAt DateTime @default(now())
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  @@index([teamId, createdAt])
}

model EventMessage {
  id        String   @id @default(cuid())
  eventId   String
  sender    String
  body      String
  createdAt DateTime @default(now())
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  @@index([eventId, createdAt])
}
